# -----------------------------------------------------------------------------
# PUBLIC — safe to expose to the browser (Next.js requires the NEXT_PUBLIC_
# prefix for that). These configure the Supabase client.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# -----------------------------------------------------------------------------
# SERVER-ONLY — never prefix these with NEXT_PUBLIC_. The app still builds
# without these set; requests to /api/chat return a safe configuration
# error until GEMINI_API_KEY is provided.
# -----------------------------------------------------------------------------

# Required for real AI responses. Create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional. Defaults to "gemini-flash-latest" (Google's auto-updating
# alias for the current stable Flash model). Set this to pin an exact
# version instead, e.g. gemini-2.5-flash.
GEMINI_MODEL=

# -----------------------------------------------------------------------------
# RAG (Phase 4) — document embedding and retrieval. All optional; sensible
# free-tier defaults are used when unset. See docs/ARCHITECTURE.md
# "RAG configuration defaults (Phase 4)" for the reasoning behind each.
# -----------------------------------------------------------------------------

# Embedding model. Defaults to "gemini-embedding-001". If you change this,
# GEMINI_EMBEDDING_DIMENSIONS and the vector(768) column in
# supabase/migrations/0005_rag.sql must stay consistent with it (see that
# migration's comments and lib/rag/embedding-provider.ts).
GEMINI_EMBEDDING_MODEL=

# Output vector width. Defaults to 768 (Google's smallest recommended
# Matryoshka truncation size). MUST match the vector(768) column in
# supabase/migrations/0005_rag.sql.
GEMINI_EMBEDDING_DIMENSIONS=

# Chunking (lib/rag/chunk.ts). Character-based, not token-based — see that
# file's comments for the approximation this relies on.
RAG_CHUNK_MAX_CHARS=
RAG_CHUNK_OVERLAP_CHARS=
RAG_CHUNK_MIN_CHARS=

# How many chunks are embedded per Gemini request during upload/reprocessing.
RAG_EMBEDDING_BATCH_SIZE=

# Retrieval (lib/rag/retrieval.ts). Top-K chunks considered, minimum
# cosine similarity ([-1, 1]) to keep a chunk, and the total character
# budget of retrieved text placed in a single prompt.
RAG_TOP_K=
RAG_SIMILARITY_THRESHOLD=
RAG_MAX_CONTEXT_CHARS=
RAG_MAX_CHARS_PER_CHUNK=

# -----------------------------------------------------------------------------
# RATE LIMITING (Phase 6) — lightweight, database-backed abuse protection,
# scoped to authenticated users (never IP-only). See
# supabase/migrations/0008_rate_limits.sql and lib/rate-limit.ts. All
# optional; defaults are generous enough for normal interactive use and
# local development/testing.
# -----------------------------------------------------------------------------

# Max /api/chat requests per authenticated user per minute. Default: 20.
RATE_LIMIT_CHAT_PER_MINUTE=

# Max document upload/reprocess requests per authenticated user per hour.
# Default: 30.
RATE_LIMIT_UPLOAD_PER_HOUR=

# Max conversation search requests per authenticated user per minute.
# Default: 60.
RATE_LIMIT_SEARCH_PER_MINUTE=
